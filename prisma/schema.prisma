generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("designer") // super_admin, admin, designer
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedRequests DesignRequest[] @relation("AssignedDesigner")
  createdRequests  DesignRequest[] @relation("RequestCreator")
  comments         Comment[]
  statusLogs       StatusLog[]
}

model DesignRequest {
  id          Int       @id @default(autoincrement())
  title       String
  category    String
  subCategory1 String?
  subCategory2 String?
  tagType     String    @default("Regular") // Regular, Custom
  client      String
  product     String?
  deadline    DateTime?
  priority    String    @default("Medium") // Low, Medium, High, Urgent
  status      String    @default("Pending") // Pending, In Progress, Accepted, On Revision, Completed
  description String?
  budget      Float?
  projectType String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Status timeline (di-set otomatis saat status berubah)
  startedAt     DateTime?
  acceptedAt    DateTime?
  onRevisionAt  DateTime?
  completedAt   DateTime?

  assignedDesignerId Int?
  assignedDesigner   User? @relation("AssignedDesigner", fields: [assignedDesignerId], references: [id])

  createdById Int?
  createdBy   User? @relation("RequestCreator", fields: [createdById], references: [id])

  comments   Comment[]
  files      File[]
  statusLogs StatusLog[]
}

model StatusLog {
  id        Int      @id @default(autoincrement())
  from      String
  to        String
  createdAt DateTime @default(now())

  requestId Int
  request   DesignRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  changedById Int?
  changedBy   User? @relation(fields: [changedById], references: [id])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())

  requestId Int
  request   DesignRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  authorId Int?
  author   User? @relation(fields: [authorId], references: [id])
  authorName String // fallback jika author dihapus
}

model File {
  id        Int      @id @default(autoincrement())
  name      String
  url       String
  mimeType  String?
  size      Int?
  type      String   @default("reference") // reference | designer
  createdAt DateTime @default(now())

  requestId Int
  request   DesignRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}
